# Virtual environments
.venv/
venv/
ENV/

# Environment variables
.env
.env.*
!.env.example

# Python cache and bytecode
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg

# Testing and coverage
.pytest_cache/
.coverage
htmlcov/
nosetests.xml
coverage.xml
*,cover

# Data storage (exclude all data files except gitkeeps)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/vectorstore/*
!data/vectorstore/.gitkeep

# Streamlit config and cache
.streamlit/
*.log
logs/


# OS files
.DS_Store
Thumbs.db

# IDE settings
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# SQLite database files and caches
*.sqlite
*.db

# Generated reports & experiment runs
reports/
data/evaluation/embedding_cache.sqlite

# Scratch files
scratch_prefix.py

# Additional ignored data directories
data/foundational/
data/temp_uploads/
data/ui_cache/